{
  "mcpServers": {
    "tetris": {
      "command": "uvx",
      "args": [
        "--no-cache",
        "--from",
        ".",
        "tetris-vt-server"
      ],
      "requestTimeoutMs": 120000,
      "env": {
        "TETRIS_GAME_DIR": "!pwd",
        "TETRIS_SCORES": "/tmp/tetris-mcp-scores.json"
      }
    }
  }
}
